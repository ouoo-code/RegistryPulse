APP_ENV=development
APP_NAME=Container Registry Monitor
APP_URL=http://localhost
TZ=Asia/Shanghai
# Docker Hub image used by api, worker, and frontend. Replace the namespace when deploying published images.
REGISTRYPULSE_IMAGE=ouoocode/registrypulse
REGISTRYPULSE_VERSION=latest
# Optional local mirror overrides. Keep the defaults for normal deployments.
BASE_REGISTRY=docker.io/library
GOPROXY=https://proxy.golang.org,direct
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
HTTP_PORT=8080
POSTGRES_DB=registry_monitor
POSTGRES_USER=registry_monitor
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://registry_monitor:change_me@postgres:5432/registry_monitor?sslmode=disable
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost,http://127.0.0.1
PROBE_DEFAULT_INTERVAL=30m
PROBE_INTERVAL=30m
PROBE_RETRY_INTERVAL=3m
PROBE_CRON=
PROBE_RETRIES=2
SCHEDULE_JITTER_SECONDS=0
PROBE_MAX_CONCURRENCY=20
PROBE_TIMEOUT=10s
PROBE_DOWNLOAD_BYTES=2097152
ALLOW_PRIVATE_TARGETS=false
ALLOW_INSECURE_HTTP=false
PROBE_IP_FAMILY=auto
PROBE_SOCKS5_PROXY=
ENABLE_REAL_DOCKER_PULL=false
PROBE_TEST_IMAGE=library/hello-world:latest
PROBE_PULL_MAX_BYTES=67108864
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
SLOW_THRESHOLD=3
DATA_RETENTION_RAW_DAYS=30
DATA_RETENTION_TASK_DAYS=30
DATA_RETENTION_AUDIT_DAYS=180
DATA_RETENTION_INCIDENT_DAYS=180
PUBLIC_API_ENABLED=true
PUBLIC_API_RATE_LIMIT=120
GOTIFY_ENABLED=false
GOTIFY_URL=
GOTIFY_TOKEN=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional local validation and CI/E2E controls.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
